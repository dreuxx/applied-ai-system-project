{
  "name": "cuecrate",
  "version": "2.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "api": "node --env-file-if-exists=.env server/local.cjs",
    "build": "expo export --platform web && node tools/offline-web.cjs",
    "preview": "node --env-file-if-exists=.env server/local.cjs --preview",
    "test": "node --test tests/rest.test.cjs && node tests/evaluate.cjs"
  },
  "dependencies": {
    "expo": "58.0.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4",
    "@expo/metro-runtime": "~58.0.17",
    "expo-audio": "~58.0.12",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "react-native-safe-area-context": "~5.11.1"
  }
}
